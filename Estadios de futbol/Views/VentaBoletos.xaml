<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Estadios_de_futbol.Views.VentaBoletos"
             Title="Venta de Boletos"
             BackgroundColor="#121212">
    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">

            <Label Text="🎟 Venta de Boletos"
                   TextColor="#F5C842"
                   FontAttributes="Bold"
                   FontSize="28"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10"/>

            <Frame BackgroundColor="#1E1E1E" BorderColor="#333333" CornerRadius="10" Padding="15">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Grid.Column="0" Text="📅" FontSize="28"
                           VerticalOptions="Center" Margin="0,0,12,0"/>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Fecha Actual" TextColor="Gray" FontSize="12"/>
                        <Label x:Name="LblFechaActual"
                               TextColor="White" FontAttributes="Bold" FontSize="16"/>
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <Frame BackgroundColor="#1E1E1E" BorderColor="#333333" CornerRadius="10" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Selección de Evento"
                           TextColor="#F5C842" FontAttributes="Bold" FontSize="16"/>

                    <Label Text="Estadio" TextColor="White" FontSize="14"/>
                    <Picker x:Name="PkrEstadio"
                            Title="Seleccione un estadio"
                            TextColor="White"
                            TitleColor="Gray"
                            SelectedIndexChanged="OnEstadioChanged"/>

                    <Label Text="Evento" TextColor="White" FontSize="14" Margin="0,5,0,0"/>
                    <Picker x:Name="PkrEvento"
                            Title="Seleccione un evento"
                            TextColor="White"
                            TitleColor="Gray"
                            SelectedIndexChanged="OnEventoChanged"/>

                    <Label Text="ℹ  Solo eventos con más de 2 días de anticipación"
                           TextColor="Gray" FontSize="11" Margin="0,4,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <Frame x:Name="FrameInfoEvento"
                   BackgroundColor="#1E1E1E" BorderColor="#F5C842"
                   CornerRadius="10" Padding="15" IsVisible="False">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Información del Evento"
                           TextColor="#F5C842" FontAttributes="Bold" FontSize="16"/>

                    <Label x:Name="LblNombreEvento"
                           TextColor="White" FontAttributes="Bold"
                           FontSize="18" HorizontalOptions="Center"/>

                    <Label x:Name="LblFechaEvento"
                           TextColor="Gray" FontSize="13" HorizontalOptions="Center"/>

                    <BoxView HeightRequest="1" Color="#333333" Margin="0,4"/>

                    <Grid ColumnDefinitions="*,*,*">
                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                            <Label Text="🎫" FontSize="22" HorizontalOptions="Center"/>
                            <Label Text="Totales" TextColor="Gray" FontSize="11" HorizontalOptions="Center"/>
                            <Label x:Name="LblTotales" TextColor="White"
                                   FontAttributes="Bold" FontSize="20" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                            <Label Text="✅" FontSize="22" HorizontalOptions="Center"/>
                            <Label Text="Disponibles" TextColor="Gray" FontSize="11" HorizontalOptions="Center"/>
                            <Label x:Name="LblDisponibles" TextColor="#4CAF50"
                                   FontAttributes="Bold" FontSize="20" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                            <Label Text="💰" FontSize="22" HorizontalOptions="Center"/>
                            <Label Text="Recaudado" TextColor="Gray" FontSize="11" HorizontalOptions="Center"/>
                            <Label x:Name="LblRecaudado" TextColor="#F5C842"
                                   FontAttributes="Bold" FontSize="16" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Frame x:Name="FrameVenta"
                   BackgroundColor="#1E1E1E" BorderColor="#333333"
                   CornerRadius="10" Padding="15" IsVisible="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Datos de la Venta"
                           TextColor="#F5C842" FontAttributes="Bold" FontSize="16"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Cantidad de Boletos" TextColor="White" FontSize="14"/>
                            <Entry x:Name="EntCantidad"
                                   Placeholder="0" Keyboard="Numeric"
                                   TextColor="White" PlaceholderColor="Gray"
                                   TextChanged="OnCantidadChanged"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Precio Unitario" TextColor="White" FontSize="14"/>
                            <Label x:Name="LblPrecioUnitario"
                                   TextColor="#F5C842" FontAttributes="Bold"
                                   FontSize="18" VerticalOptions="Center" Margin="0,10,0,0"/>
                        </VerticalStackLayout>
                    </Grid>

                    <Frame BackgroundColor="#2A2A2A" BorderColor="#444444" CornerRadius="8" Padding="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Total a Cobrar:"
                                   TextColor="White" FontSize="15" VerticalOptions="Center"/>
                            <Label Grid.Column="1" x:Name="LblTotal"
                                   Text="$0.00" TextColor="#F5C842"
                                   FontAttributes="Bold" FontSize="22" VerticalOptions="Center"/>
                        </Grid>
                    </Frame>

                    <Label Text="Nombre del Cliente" TextColor="White" FontSize="14" Margin="0,5,0,0"/>
                    <Entry x:Name="EntCliente"
                           Placeholder="Nombre completo"
                           TextColor="White" PlaceholderColor="Gray"/>

                    <Label Text="Teléfono" TextColor="White" FontSize="14"/>
                    <Entry x:Name="EntTelefono"
                           Placeholder="10 dígitos" Keyboard="Telephone"
                           TextColor="White" PlaceholderColor="Gray"/>
                </VerticalStackLayout>
            </Frame>

          
            <Frame x:Name="FrameStatus" CornerRadius="10" Padding="15" IsVisible="False">
                <Label x:Name="LblStatus"
                       FontSize="14" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" TextColor="White"/>
            </Frame>

           
            <Grid x:Name="GridBotones"
                  ColumnDefinitions="*,*" ColumnSpacing="15" IsVisible="False">
                <Button Grid.Column="0"
                        Text="GUARDAR"
                        Clicked="OnGuardarClicked"
                        BackgroundColor="#F5C842"
                        TextColor="Black"
                        FontAttributes="Bold"
                        FontSize="16"
                        HeightRequest="55"
                        CornerRadius="28"/>
                <Button Grid.Column="1"
                        Text="CANCELAR"
                        Clicked="OnCancelarClicked"
                        BackgroundColor="#333333"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        HeightRequest="55"
                        CornerRadius="28"/>
            </Grid>

           
            <Button Text="🗑 BORRAR VENTAS PASADAS"
                    Clicked="OnBorrarPasadasClicked"
                    BackgroundColor="#8B0000"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="14"
                    HeightRequest="50"
                    CornerRadius="25"
                    Margin="0,0,0,10"/>

            <ActivityIndicator x:Name="Cargando"
                               IsRunning="False" IsVisible="False"
                               Color="#F5C842" HeightRequest="40" Margin="0,0,0,20"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>